{
  "name": "harbouros",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/characterization/*.test.ts tests/unit/*.test.ts tests/db/*.test.ts tests/api/*.test.ts",
    "test:api": "tsx --test --test-concurrency=1 tests/api/*.test.ts",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "check:openapi": "tsx scripts/gen-openapi.ts --check",
    "anchor:ledger": "tsx scripts/anchor-ledger.ts",
    "verify:ledger": "tsx scripts/verify-ledger.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:budget": "tsx scripts/check-budget.ts",
    "ci:local": "bash scripts/ci-local.sh",
    "check": "tsc --noEmit && ! grep -rnE \"catch\\s*(\\([^)]*\\))?\\s*\\{\\s*(//[^\\n]*)?\\s*\\}\" tests scripts src && tsx --test --test-concurrency=1 tests/characterization/*.test.ts tests/unit/*.test.ts tests/db/*.test.ts tests/api/*.test.ts && tsx scripts/check-boundaries.ts && tsx scripts/check-contrast.ts && vite build && tsx scripts/check-budget.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@google/genai": "^2.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "jose": "^6.2.15",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tsx": "^4.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
