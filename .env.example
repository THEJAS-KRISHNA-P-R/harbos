NODE_ENV=development
PORT=3000
DATABASE_URL=                 # empty = PGlite in-process; set for any real Postgres
JWT_ACCESS_SECRET=dev-access-secret-replace-with-32-bytes-0000
JWT_REFRESH_SECRET=dev-refresh-secret-replace-with-32-bytes-000
QR_HMAC_SECRET=dev-qr-hmac-secret-replace-with-32-bytes-0000
OTP_DEV_ECHO=true             # true only in dev/demo; boot fails if true in production
DEMO_MODE=true                # seeds demo data and enables persona switcher
LLM_PROVIDER=none             # none | gemini
LLM_MODEL_VISION=gemini-2.5-flash
GEMINI_API_KEY=
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
