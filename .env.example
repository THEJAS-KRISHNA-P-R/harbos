# HarbourOS Production-Safe Environment Template (.env.example)
# NEVER commit real secrets. Production boot refuses missing DATABASE_URL, weak/placeholder secrets, DEMO_MODE=true, OTP_DEV_ECHO=true, or SMS_PROVIDER=console.

NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# Required in production: managed PostgreSQL 16 connection string (using harbour_app role)
DATABASE_URL=

# Required in production: distinct cryptographically random secrets (>= 32 bytes each)
JWT_ACCESS_SECRET=
QR_HMAC_SECRET=

# Security guardrails (MUST be false in production)
OTP_DEV_ECHO=false
DEMO_MODE=false

# SMS & Notification Providers (production requires a real DLT-registered provider, e.g. msg91)
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# Optional LLM Catch Photo Assist (default: none)
LLM_PROVIDER=none
LLM_MODEL_VISION=gemini-2.5-flash
GEMINI_API_KEY=
